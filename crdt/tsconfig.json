{
  "compilerOptions": {
    // 1. 핵심 경로 설정 (필수)
    "rootDir": "./src", // TypeScript 소스 코드 폴더
    "outDir": "./dist", // 컴파일된 JavaScript가 저장될 폴더

    // 2. 모듈 및 환경 설정 (가장 중요)
    "module": "commonjs", // 'nodenext'(ESM) 대신 Node.js 백엔드 표준인 'commonjs' 사용
    "target": "es2020", // 'esnext' 대신 Node.js 14+와 호환되는 안정적인 타겟 지정
    "lib": ["es2020"],
    "types": ["node"], // (FIXED) 'process.env', 'Buffer' 등 Node.js 기본 타입을 로드

    // 3. 편의성 및 호환성
    "esModuleInterop": true, // 'import express from "express"' 같은 구문 허용
    "skipLibCheck": true, // 라이브러리 타입 체크 스킵 (빌드 속도 향상)
    "forceConsistentCasingInFileNames": true, // 파일 이름 대소문자 일관성 강제

    // 4. 엄격한 타입 체크 (유지)
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // 5. 소스맵 (디버깅용)
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
    
    // (REMOVED) "jsx": "react-jsx" (백엔드 서버에 불필요)
    // (REMOVED) "verbatimModuleSyntax", "isolatedModules", "moduleDetection" ('commonjs'에 불필요)
  },
  // 6. 컴파일 범위 지정 (필수)
  "include": ["src/**/*"], // 'src' 폴더 내부의 모든 .ts 파일
  "exclude": ["node_modules"] // 'node_modules' 폴더 제외
}