{
  "name": "zzikgoga-crdt-server",
  "version": "1.0.0",
  "description": "CRDT WebSocket server using Yjs for real-time collaboration",
  "main": "server.js",
  "scripts": {
    "start": "pm2-runtime start ecosystem.config.js",
    "dev": "node server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop zzikgoga-yjs-server",
    "pm2:restart": "pm2 restart zzikgoga-yjs-server",
    "pm2:logs": "pm2 logs zzikgoga-yjs-server",
    "pm2:monit": "pm2 monit"
  },
  "keywords": [
    "yjs",
    "crdt",
    "websocket",
    "real-time",
    "collaboration"
  ],
  "author": "ZZIKGOGA Team",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "yjs": "^13.6.20",
    "y-websocket": "^2.0.4",
    "lib0": "^0.2.98",
    "pm2": "^5.4.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
